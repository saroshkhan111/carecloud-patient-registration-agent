# ==============================================================================
# ElevenLabs Conversational AI Agent - Environment Configuration
# ==============================================================================

# 1. ElevenLabs Agent & API Keys (Required)
# ------------------------------------------------------------------------------
# Your Conversational AI Agent ID from ElevenLabs dashboard (e.g. agent_1101m55h130jepzr2v1wesm8s1n0)
AGENT_ID=agent_1101m55h130jepzr2v1wesm8s1n0

# Your ElevenLabs API Key from Profile -> API Keys (starts with sk_...)
# Supports both ELEVENLABS_API_KEY and ELEVENLABS_API__KEY
ELEVENLABS_API_KEY=sk_your_elevenlabs_api_key_here

# Secret tool token configured in ElevenLabs Agent Tool Settings -> Headers
# Used to verify that tool webhook calls to your FastAPI backend are genuine
ELEVENLABS_TOOL_TOKEN=UpXsO70NlVOzd1ExLqXqbGTcPLXtF3xtzZzhFBzAy2E

# 2. Database & Application Environment
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./carecloud.db
ENVIRONMENT=local
HOST=0.0.0.0
PORT=8000
# Real dialable U.S. phone number provisioned in ElevenLabs or Twilio
PHONE_NUMBER=+1 (202) 555-0193

# 3. Reviewer & Admin Credentials
# ------------------------------------------------------------------------------
REVIEWER_USERNAME=reviewer
REVIEWER_PASSWORD=reviewer-pass
